# Copy to the external run root, replace every placeholder, and source it only from a submitted copy.
# Generate the two checksum manifests before submission; do not place raw products in the repository.
REPO_ROOT=/xdisk/chopinsong/tianyihu/elm-olmt
PATH_ROOT=/path/to/external/optimization_run
CAMPAIGN=/path/to/external/optimization_run/campaign.yaml
POOL=/path/to/external/optimization_run/initialization/artifacts/candidate_pool.npz
REPOSITORY_COMMIT=REPLACE_WITH_GIT_COMMIT
SOURCE_MANIFEST=/path/to/external/optimization_run/source_manifest.sha256
DEPENDENCY_MANIFEST=/path/to/external/optimization_run/dependency_manifest.sha256
N_PROCESSES=16
